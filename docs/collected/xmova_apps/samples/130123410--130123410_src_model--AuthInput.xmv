AuthInput
	idEmpresa Empresa hide
	descricaoEmpresa Str autoFill=idEmpresa.NOME
	idFilial Filial autoFillWhenOneItem hide
	descricaoFilial Str autoFill=idFilial.NOME
	idLocal Local autoFillWhenOneItem hide
	descricaoLocal Str autoFill=idLocal.NOME
	idChaveAcesso int notFormatThousand onlineValidate=chave hide
	codigoFuncionario int notFormatThousand onlineValidate=ValidaFuncionario_Mobile 
	seqFuncionario long notFill hide
	nomeFuncionario Str notFill
	confirmaConfig boolean notShowNo hide
	fieldEvents
		fillCondition
			codigoFuncionario
				seqFuncionario = null
				nomeFuncionario = null
				return true
		filterListRecord
			idFilial
				return listRecord.EMPRESA_SEQ_DB == :idEmpresa
			idLocal
				return listRecord.FILIAL_SEQ_DB == :idFilial
		getInputScreenLabel
			confirmaConfig
				return lang=custom.msgCustomConfirmaConfig
//Busca de informações no BD antes da instalação