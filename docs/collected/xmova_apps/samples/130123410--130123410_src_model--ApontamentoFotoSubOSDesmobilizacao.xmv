ApontamentoFotoSubOSDesmobilizacao sync=out cleanupDays=7
	id inc ignoreExternal
	boletim Boletim ignoreExternal
	seqFuncionario SeqFuncionario
	apontamentoSubOSDesmobilizacao ApontamentoSubOSDesmobilizacao ignoreExternal
	contador int autoFill=apontamentoSubOSDesmobilizacao.contador ignoreExternal	
	novaFoto boolean notShowNo ignoreExternal fillCondition="contador > 0"
	flagSubOS boolean autoFill=apontamentoSubOSDesmobilizacao.flagSubOS ignoreExternal
	data Now timeTypeField=tipoData
	flagOnline int notFill onlineFlagCreate
	location Location inlineData
	SEQ_DB_DEVICE_MASTER long autoFill=boletim.SEQ_DB_DEVICE
	SEQ_DB_DEVICE long uuid
	SEQ_DB_DEVICE_SUB_OS long autoFill=apontamentoSubOSDesmobilizacao.SEQ_DB_DEVICE
	subOS SUB_OS autoFill=apontamentoSubOSDesmobilizacao.subOS ignoreExternal fillCondition="flagSubOS==true"
	subOS_SEQ_DB long autoFill=subOS.SEQ_DB fillCondition="flagSubOS==true"
	hardware HARDWARE autoFill=apontamentoSubOSDesmobilizacao.hardware
	equipamento EQUIPAMENTO_LIST autoFill=apontamentoSubOSDesmobilizacao.equipamento
	cliente_projeto PROJETO autoFill=apontamentoSubOSDesmobilizacao.cliente_projeto
	tipo_sub_os int autofill=apontamentoSubOSDesmobilizacao.tipoSubOS
	foto Binary picture
	registraOBS boolean ignoreExternal
	observacao text maxLength=5000 fillCondition="registraOBS==true"
	server name=apontamentoFotoSubOS
	events
		afterInsert
			contador = contador + 1
			ApontamentoSubOSDesmobilizacao apt = apontamentoSubOSDesmobilizacao
			apt.contador = contador
			save apt
	fieldEvents
		autoFill
			boletim
				return SelectLast FROM Boletim
//----------------FIM DESMOBILIZAÇÃO-----------------------------