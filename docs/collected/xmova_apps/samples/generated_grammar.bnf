<R25> ::= "custom.msgCustomConfirmaConfig" "=" "Funcionário:" "%nomeFuncionario\n\nDeseja" "Confirmar" "a" "Configuração?"
<R26> ::= "custom.msgCustomConfirmaRegistroRefeicaoI" "=" "Deseja" "Registrar" "o" "ponto" "de" "inicio" "de" "refeição?\n\nData" "do" "Ponto:" "%data"
<R27> ::= "custom.msgCustomConfirmaPonto" "=" "Confirmar" "o" "Registro" "de" "Ponto?\n\nData" "do" "Ponto:" "%data"
<R28> ::= "custom.msgCustomConfirmaPonto2" "=" "Confirmar" "o" "Registro" "de" "Ponto?\n\nData" "do" "Ponto:" "%data\n\nO" "tempo" "mínimo" "de" NUMBER "minutos" "entre" "um" "ponto" "e" "outro" "não" "foi" "atingido\n\nO" "intervalo" "entre" "esse" "registro" "e" "o" "anterior" "será" "de:" "%duracao"
<R29> ::= "custom.msgBloqueiaFim" "=" "Para" "encerrar" "a" "OS" "é" "necessário" "a" "assinatura" "do" "Cliente"
<R30> ::= "custom.msgInterrupcao" "=" "Deslocamento" "interrompido" "pelo" "motivo" "<%motivo>.\nAo" "finalizar" "interrupção" "pressione" ""<STR>"" "para" "retomar" "o" "deslocamento."
<R31> ::= "custom.deslocamentoKmFinalMenorKmInicial" "=" "Km" "Final" "informado" "(%kmFinal)" "menor" "que" "o" "KM" "Inicial" "(%kmInicial)." "Confirma?"
<R32> ::= "custom.deslocamentoKmAtualMenorKmInicial" "=" "Km" "Atual" "informado" "(%kmAtual)" "menor" "que" "o" "KM" "Inicial" "(%kmInicial)." "Confirma?"
<R33> ::= "custom.msgBloqueiaHorimetroMarte" "=" "Necessária" "pelo" "menos" NUMBER "foto" "para" "prosseguir."
<R34> ::= "custom.msgBloqueiaFimMarte" "=" "Para" "pausar<PATH>" "a" "OS" "é" "necessário" "finalizar" "a" "instalação" "do" "Marte"
<R35> ::= "custom.msgHodometroInvalido" "=" "Hodômetro" "inválido!"
<R36> ::= "custom.msgManutSucesso" "=" "Manutenção" "Realizada" "Com" "Sucesso!"
<R37> ::= "custom.msgCustomInstSucesso" "=" "Instalação" "Realizada" "com" "Sucesso!"
<R38> ::= "custom.msgCustomDesmSucesso" "=" "Desmobilização" "Realizada" "com" "Sucesso!"
