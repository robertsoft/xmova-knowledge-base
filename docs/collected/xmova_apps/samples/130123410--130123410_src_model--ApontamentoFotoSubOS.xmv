ApontamentoFotoSubOS sync=out cleanupDays=7 noFinishAction
	id inc ignoreExternal
	boletim Boletim ignoreExternal
	seqFuncionario SeqFuncionario
	apontamentoSubOSManut ApontamentoSubOSManut ignoreExternal
	contador int autoFill=apontamentoSubOSManut.contador ignoreExternal
	novaFoto boolean notShowNo ignoreExternal fillCondition="contador > 0"
	data Now timeTypeField=tipoData
	flagOnline int notFill onlineFlagCreate
	location Location inlineData
	SEQ_DB_DEVICE_MASTER long autoFill=boletim.SEQ_DB_DEVICE
	SEQ_DB_DEVICE long uuid
	SEQ_DB_DEVICE_SUB_OS long autoFill=apontamentoSubOSManut.SEQ_DB_DEVICE
	flagSubOS boolean autoFill=apontamentoSubOSManut.flagSubOS ignoreExternal
	subOS SUB_OS autoFill=apontamentoSubOSManut.subOS ignoreExternal fillCondition="flagSubOS==true"
	subOS_SEQ_DB long autoFill=apontamentoSubOSManut.subOS_SEQ_DB fillCondition="flagSubOS==true"
	hardware HARDWARE autoFill=apontamentoSubOSManut.hardware
	hwFalhaIdentificada HW_FALHA autoFill=apontamentoSubOSManut.hwFalhaIdentificada
	hwSolucao HW_SOLUCAO autoFill=apontamentoSubOSManut.hwSolucao
	equipamento EQUIPAMENTO_LIST autoFill=apontamentoSubOSManut.equipamento
	cliente_projeto PROJETO autoFill=apontamentoSubOSManut.cliente_projeto
	tipo_sub_os int autofill=apontamentoSubOSManut.tipoSubOS
	foto Binary picture
	registraOBS boolean ignoreExternal
	observacao text maxLength=5000 fillCondition="registraOBS==true"
	server name=apontamentoFotoSubOS
	events
		afterInsert
			contador = contador + 1
			ApontamentoSubOSManut apt = apontamentoSubOSManut
			apt.contador = contador
			save apt
	fieldEvents
		autoFill
			boletim
				return SelectLast FROM Boletim